  "promptCalls": {
    "note": "ADR 0017: the prompt actions in a flow definition (workflow.clientdata), read as text so the flow can do the same. After each operationId value starting aibuilderpredict_, the operation is the rest of that value; its recordId is the first recordId value before the next operationId key. The recordId is a prompt id only when it does not start with @ and is 36 characters in 5 parts separated by hyphens; otherwise the prompt is chosen at run time (empty id). Expected: operation|promptId. Stored definitions are compact JSON (pp-lab, 2026-11-23).",
    "cases": [
      { "id": "pc-01", "note": "picked in the designer: a literal id, lower-cased", "clientData": "{\"properties\":{\"definition\":{\"actions\":{\"Run_a_prompt\":{\"type\":\"OpenApiConnection\",\"inputs\":{\"host\":{\"connectionName\":\"shared_commondataserviceforapps\",\"operationId\":\"aibuilderpredict_customprompt\",\"apiId\":\"/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps\"},\"parameters\":{\"recordId\":\"6F0B2C1D-3E4A-4B5C-8D6E-7F8091A2B3C4\",\"item/requestv2/Text\":\"x\"}}}}}}}", "expected": ["customprompt|6f0b2c1d-3e4a-4b5c-8d6e-7f8091a2b3c4"] },
      { "id": "pc-02", "note": "two prompt actions, one inside a scope, in definition order", "clientData": "{\"properties\":{\"definition\":{\"actions\":{\"Run_a\":{\"type\":\"OpenApiConnection\",\"inputs\":{\"host\":{\"connectionName\":\"shared_commondataserviceforapps\",\"operationId\":\"aibuilderpredict_customprompt\",\"apiId\":\"/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps\"},\"parameters\":{\"recordId\":\"6f0b2c1d-3e4a-4b5c-8d6e-7f8091a2b3c4\",\"item/requestv2/Text\":\"x\"}}},\"Scope\":{\"type\":\"Scope\",\"actions\":{\"Run_b\":{\"type\":\"OpenApiConnection\",\"inputs\":{\"host\":{\"connectionName\":\"shared_commondataserviceforapps\",\"operationId\":\"aibuilderpredict_customprompt\",\"apiId\":\"/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps\"},\"parameters\":{\"recordId\":\"0a1b2c3d-4e5f-4a6b-8c7d-9e0f1a2b3c4d\",\"item/requestv2/Text\":\"x\"}}}}}}}}}", "expected": ["customprompt|6f0b2c1d-3e4a-4b5c-8d6e-7f8091a2b3c4", "customprompt|0a1b2c3d-4e5f-4a6b-8c7d-9e0f1a2b3c4d"] },
      { "id": "pc-03", "note": "an expression: a prompt chosen at run time, so no prompt id", "clientData": "{\"properties\":{\"definition\":{\"actions\":{\"Run_a\":{\"type\":\"OpenApiConnection\",\"inputs\":{\"host\":{\"connectionName\":\"shared_commondataserviceforapps\",\"operationId\":\"aibuilderpredict_customprompt\",\"apiId\":\"/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps\"},\"parameters\":{\"recordId\":\"@first(body('Find_prompt')?['value'])?['msdyn_aimodelid']\",\"item/requestv2/Text\":\"x\"}}}}}}}", "expected": ["customprompt|"] },
      { "id": "pc-04", "note": "no AI Builder action: nothing, even though another action has a recordId", "clientData": "{\"properties\":{\"definition\":{\"actions\":{\"Get_row\":{\"type\":\"OpenApiConnection\",\"inputs\":{\"host\":{\"connectionName\":\"shared_commondataserviceforapps\",\"operationId\":\"GetItem\",\"apiId\":\"/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps\"},\"parameters\":{\"entityName\":\"accounts\",\"recordId\":\"0a1b2c3d-4e5f-4a6b-8c7d-9e0f1a2b3c4d\"}}}}}}}", "expected": [] },
