      { "id": "pc-06", "note": "a literal that is not 36 characters in 5 parts is not an id", "clientData": "{\"properties\":{\"definition\":{\"actions\":{\"Run_a\":{\"type\":\"OpenApiConnection\",\"inputs\":{\"host\":{\"connectionName\":\"shared_commondataserviceforapps\",\"operationId\":\"aibuilderpredict_customprompt\",\"apiId\":\"/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps\"},\"parameters\":{\"recordId\":\"not-a-guid\",\"item/requestv2/Text\":\"x\"}}}}}}}", "expected": ["customprompt|"] },
