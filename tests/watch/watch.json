{
  "description": "Watch list (ADR 0015): which signals a topic watch matches, and which watch events a signal version raises. Written before engine/ChangeRadar.Watch.psm1. Text is the title plus the readable summary (engine ConvertTo-ReadableText), lower-cased, with punctuation turned into spaces; a term matches as whole words. Ignore phrases are removed before the check. Lists are semicolon-separated.",
  "watches": {
    "w-autopilot": { "name": "Copilot Autopilot in the UK", "active": true, "anyOf": "Autopilot", "alsoOneOf": "UK; United Kingdom; Europe; EU; region; regions; rollout; rolling out; general availability", "ignore": "Windows Autopilot", "products": "" },
    "w-uk-only": { "name": "Autopilot, UK only", "active": true, "anyOf": "Autopilot", "alsoOneOf": "UK", "ignore": "", "products": "" },
    "w-both-spellings": { "name": "Organisation settings", "active": true, "anyOf": "organisation; organization", "alsoOneOf": "", "ignore": "", "products": "" },
    "w-british-only": { "name": "British spelling only", "active": true, "anyOf": "organisation", "alsoOneOf": "", "ignore": "", "products": "" },
    "w-studio-agents": { "name": "Copilot Studio agents", "active": true, "anyOf": "agent; agents", "alsoOneOf": "", "ignore": "", "products": "Copilot Studio" },
    "w-inactive": { "name": "Switched off", "active": false, "anyOf": "Autopilot", "alsoOneOf": "", "ignore": "", "products": "" },
    "w-empty": { "name": "No words", "active": true, "anyOf": "", "alsoOneOf": "", "ignore": "", "products": "" }
  },
  "match": [
    { "id": "wm-01", "note": "Plain match: the topic word and a region word", "watch": "w-autopilot",
      "signal": { "title": "Copilot Autopilot rolling out to tenants in Europe", "summary": "", "products": "Microsoft Copilot (Microsoft 365)" }, "expected": true },
    { "id": "wm-02", "note": "Near miss: Windows Autopilot only, even with a region word, is ignored", "watch": "w-autopilot",
      "signal": { "title": "Windows Autopilot device preparation update", "summary": "<p>Available in all regions.</p>", "products": "Microsoft Intune" }, "expected": false },
    { "id": "wm-03", "note": "Both Autopilots: the ignored phrase is removed, the other mention still matches", "watch": "w-autopilot",
      "signal": { "title": "Windows Autopilot and Copilot Autopilot: rollout update", "summary": "", "products": "" }, "expected": true },
    { "id": "wm-04", "note": "The topic word without any of the 'also one of' words", "watch": "w-autopilot",
      "signal": { "title": "Copilot Autopilot adds new skills", "summary": "<p>New skills for scheduling.</p>", "products": "" }, "expected": false },
    { "id": "wm-05", "note": "A term inside another word doesn't count (UK in Ukrainian)", "watch": "w-uk-only",
      "signal": { "title": "Autopilot adds Ukrainian language support", "summary": "", "products": "" }, "expected": false },
    { "id": "wm-06", "note": "Punctuation around a term", "watch": "w-uk-only",
      "signal": { "title": "Autopilot (UK) availability", "summary": "", "products": "" }, "expected": true },
    { "id": "wm-07", "note": "Words found in the HTML summary, read as text (tags, &nbsp;, bold)", "watch": "w-uk-only",
      "signal": { "title": "What's new this month", "summary": "<p>Copilot&nbsp;Autopilot is now available in the <strong>UK</strong>.</p>", "products": "" }, "expected": true },
    { "id": "wm-08", "note": "Case doesn't matter", "watch": "w-uk-only",
      "signal": { "title": "AUTOPILOT now in the uk", "summary": "", "products": "" }, "expected": true },
    { "id": "wm-09", "note": "American spelling matches when both spellings are listed", "watch": "w-both-spellings",
      "signal": { "title": "New organization settings in the admin centre", "summary": "", "products": "" }, "expected": true },
    { "id": "wm-10", "note": "No automatic spelling variants: list both if you want both", "watch": "w-british-only",
      "signal": { "title": "New organization settings in the admin centre", "summary": "", "products": "" }, "expected": false },
    { "id": "wm-11", "note": "A phrase matches across a hyphen", "watch": "w-autopilot",
      "signal": { "title": "Autopilot reaches general-availability", "summary": "", "products": "" }, "expected": true },
    { "id": "wm-12", "note": "Products set: a signal for another product doesn't match", "watch": "w-studio-agents",
      "signal": { "title": "New agents gallery", "summary": "", "products": "Power Apps" }, "expected": false },
    { "id": "wm-13", "note": "Products set: the product is contained in the signal's products", "watch": "w-studio-agents",
      "signal": { "title": "New agents gallery", "summary": "", "products": "Microsoft Copilot Studio; Power Apps" }, "expected": true },
    { "id": "wm-14", "note": "A switched-off watch never matches", "watch": "w-inactive",
      "signal": { "title": "Copilot Autopilot in the UK", "summary": "", "products": "" }, "expected": false },
    { "id": "wm-15", "note": "A watch with no words never matches", "watch": "w-empty",
      "signal": { "title": "Anything at all", "summary": "", "products": "" }, "expected": false },
    { "id": "wm-16", "note": "An ignored phrase written with a hyphen is still ignored", "watch": "w-autopilot",
      "signal": { "title": "Windows-Autopilot rollout in Europe", "summary": "", "products": "" }, "expected": false },
    { "id": "wm-17", "note": "Curly apostrophes and quotes are punctuation", "watch": "w-uk-only",
      "signal": { "title": "“Autopilot” arrives in the UK’s tenants", "summary": "", "products": "" }, "expected": true }
  ],
  "events": [
    { "id": "we-01", "note": "New signal matching a topic: watch.matched", "watches": ["w-autopilot", "w-studio-agents"], "created": true, "wasWatched": false, "changedFields": "created",
      "signal": { "title": "Copilot Autopilot rolling out in the UK", "summary": "", "products": "" },
      "expected": [{ "type": "watch.matched", "watch": "Copilot Autopilot in the UK" }] },
    { "id": "we-02", "note": "Matching two topics raises one event, for the first by name", "watches": ["w-autopilot", "w-uk-only"], "created": true, "wasWatched": false, "changedFields": "created",
      "signal": { "title": "Copilot Autopilot rolling out in the UK", "summary": "", "products": "" },
      "expected": [{ "type": "watch.matched", "watch": "Autopilot, UK only" }] },
    { "id": "we-03", "note": "A watched signal changes: watch.updated", "watches": ["w-autopilot"], "created": false, "wasWatched": true, "changedFields": "key date; last modified",
      "signal": { "title": "Copilot Autopilot rolling out in the UK", "summary": "", "products": "" },
      "expected": [{ "type": "watch.updated", "changes": "key date" }] },
    { "id": "we-04", "note": "An unwatched signal changes and now matches: watch.matched, not updated", "watches": ["w-autopilot"], "created": false, "wasWatched": false, "changedFields": "title; last modified",
      "signal": { "title": "Copilot Autopilot rolling out in the UK", "summary": "", "products": "" },
      "expected": [{ "type": "watch.matched", "watch": "Copilot Autopilot in the UK" }] },
    { "id": "we-05", "note": "A watched signal (watched by hand, no topic matches) changes: watch.updated only", "watches": ["w-autopilot"], "created": false, "wasWatched": true, "changedFields": "last modified",
      "signal": { "title": "Something else entirely", "summary": "", "products": "" },
      "expected": [{ "type": "watch.updated", "changes": "wording" }] },
    { "id": "we-06", "note": "An unwatched signal that doesn't match: nothing", "watches": ["w-autopilot"], "created": false, "wasWatched": false, "changedFields": "key date; last modified",
      "signal": { "title": "Windows Autopilot in the UK", "summary": "", "products": "" },
      "expected": [] },
    { "id": "we-07", "note": "A new signal that doesn't match: nothing", "watches": ["w-autopilot"], "created": true, "wasWatched": false, "changedFields": "created",
      "signal": { "title": "Power Apps grid update", "summary": "", "products": "" },
      "expected": [] },
    { "id": "we-08", "note": "Opted out: a topic matched it once, then someone switched Watched off. It is never re-added and raises nothing", "watches": ["w-autopilot"], "created": false, "wasWatched": false, "optedOut": true, "changedFields": "key date; last modified",
      "signal": { "title": "Copilot Autopilot rolling out in the UK", "summary": "", "products": "" },
      "expected": [] }
  ],
  "changes": [
    { "id": "wc-01", "changedFields": "title; key date; last modified", "expected": "title, key date" },
    { "id": "wc-02", "changedFields": "date label; action required; last modified", "expected": "status, action required" },
    { "id": "wc-03", "changedFields": "last modified", "expected": "wording" },
    { "id": "wc-04", "changedFields": "title; horizon; date label; action required; key date; last modified", "expected": "title, horizon, status, action required, key date" },
    { "id": "wc-05", "changedFields": "", "expected": "wording" }
  ]
}
