{
  "description": "Expected estate impact per signal and source (ADR 0010, spec §6). Written before engine/ChangeRadar.Assessment.psm1. Each case gives a signal, its generic impact, and exposures (source, kind, environment type, status); 'expected' lists one result per source that has, or had, exposures.",
  "today": "2026-11-21",
  "estateImpactMax": 4,
  "cases": [
    {
      "id": "score-01", "note": "No exposures: nothing to assess",
      "signal": { "id": "T-01", "genericImpact": "high", "actionRequired": true, "keyDate": "2026-11-25" },
      "exposures": [],
      "expected": []
