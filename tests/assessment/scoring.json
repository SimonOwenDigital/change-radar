      "signal": { "id": "T-05", "genericImpact": "high", "actionRequired": true, "keyDate": "2026-11-30" },
      "exposures": [ { "source": "live", "kind": "asset", "assetId": "a1", "environmentType": "production", "status": "new" } ],
      "expected": [ { "source": "live", "estateImpact": "critical", "affectedCount": 1, "unknownEnvironmentCount": 0, "productionBonus": true, "actionBonus": true } ]
    },
