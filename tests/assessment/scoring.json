      "signal": { "id": "T-14", "genericImpact": "low", "actionRequired": true, "keyDate": "2026-12-21" },
      "exposures": [ { "source": "live", "kind": "asset", "assetId": "a1", "environmentType": "developer", "status": "new" } ],
      "expected": [ { "source": "live", "estateImpact": "medium", "affectedCount": 1, "unknownEnvironmentCount": 0, "productionBonus": false, "actionBonus": true } ]
    },
    {
