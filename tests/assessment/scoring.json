    {
      "id": "score-02", "note": "Generic medium, one developer asset, no action: stays medium",
      "signal": { "id": "T-02", "genericImpact": "medium", "actionRequired": false, "keyDate": "2026-12-01" },
      "exposures": [ { "source": "live", "kind": "asset", "assetId": "a1", "environmentType": "developer", "status": "new" } ],
      "expected": [ { "source": "live", "estateImpact": "medium", "affectedCount": 1, "unknownEnvironmentCount": 0, "productionBonus": false, "actionBonus": false } ]
    },
    {
