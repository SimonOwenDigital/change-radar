      "signal": { "id": "T-15", "genericImpact": "low", "actionRequired": false, "keyDate": null },
      "exposures": [
        { "source": "live", "kind": "asset", "assetId": "a1", "environmentType": "developer", "status": "new" },
        { "source": "live", "kind": "asset", "assetId": "a1", "environmentType": "developer", "status": "confirmed" }
