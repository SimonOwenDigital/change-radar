{
  "description": "ADR 0026: what the public copy holds and when it is refused. Written before tools/publish/publish.py. files: path to text, or {zip:{...}}, {pdf_stream:text} or {utf16:text}, built by the test. {FORBIDDEN} stands for the forbidden value below (synthetic).",
  "forbidden": "0f0f0f0f-1111-2222-3333-444444444444",
  "cases": [
    {"name": "only listed paths are copied", "allow": ["README.md", "engine/"], "files": {"README.md": "x", "engine/a.psm1": "y", "spikes/z.md": "z"}, "published": ["README.md", "engine/a.psm1"]},
    {"name": "a new top-level file stays private", "allow": ["README.md"], "files": {"README.md": "x", "new-notes.md": "y"}, "published": ["README.md"]},
    {"name": "an exclusion wins over an inclusion", "allow": ["docs/", "!docs/private.md"], "files": {"docs/a.md": "x", "docs/private.md": "y"}, "published": ["docs/a.md"]},
    {"name": "a folder doesn't match a sibling with the same start", "allow": ["docs/"], "files": {"docs/a.md": "x", "docs-private/b.md": "y"}, "published": ["docs/a.md"]},
    {"name": "an untracked file is never copied", "allow": ["docs/"], "files": {"docs/a.md": "x"}, "untracked": {"docs/u.md": "{FORBIDDEN}"}, "published": ["docs/a.md"]},
    {"name": "a listed path that matches nothing is refused", "allow": ["README.md", "gone/"], "files": {"README.md": "x"}, "refused": "matches nothing"},
    {"name": "an exclusion that matches nothing is refused", "allow": ["README.md", "!renamed-private.md"], "files": {"README.md": "x"}, "refused": "matches nothing"},
    {"name": "forbidden value in text", "allow": ["a.md"], "files": {"a.md": "id {FORBIDDEN}"}, "refused": "a.md: forbidden value"},
    {"name": "forbidden value in capitals without dashes", "allow": ["a.md"], "files": {"a.md": "0F0F0F0F111122223333444444444444"}, "refused": "a.md: forbidden value"},
    {"name": "forbidden value in UTF-16", "allow": ["a.txt"], "files": {"a.txt": {"utf16": "{FORBIDDEN}"}}, "refused": "a.txt: forbidden value"},
    {"name": "forbidden value in a zip inside a zip", "allow": ["a.zip"], "files": {"a.zip": {"zip": {"b.zip": {"zip": {"c.xml": "{FORBIDDEN}"}}}}}, "refused": "forbidden value"},
    {"name": "forbidden value in a file name, not printed", "allow": ["d/"], "files": {"d/{FORBIDDEN}.md": "x"}, "refused": "forbidden value"},
    {"name": "sensitivity label in a docx", "allow": ["a.docx"], "files": {"a.docx": {"zip": {"docMetadata/LabelInfo.xml": "<x/>"}}}, "refused": "sensitivity label"},
    {"name": "sensitivity label in compressed PDF content", "allow": ["a.pdf"], "files": {"a.pdf": {"pdf_stream": "MSIP_Label_x"}}, "refused": "sensitivity label"},
    {"name": "a file that claims to be a zip but can't be opened", "allow": ["a.zip"], "files": {"a.zip": "PK\u0003\u0004broken"}, "refused": "can't be read"},
    {"name": "environment address", "allow": ["a.md"], "files": {"a.md": "https://fabrikam1.crm11.dynamics.com"}, "refused": "environment address"},
    {"name": "documentation placeholders are allowed", "allow": ["a.md"], "files": {"a.md": "https://<org>.crm.dynamics.com https://example.crm.dynamics.com *.onmicrosoft.com a@example.org x@odata.bind"}, "published": ["a.md"]},
    {"name": "sign-in domain", "allow": ["a.md"], "files": {"a.md": "fabrikam1.onmicrosoft.com"}, "refused": "sign-in domain"},
    {"name": "email address", "allow": ["a.md"], "files": {"a.md": "jo@realcompany.com"}, "refused": "email address"},
    {"name": "local user path", "allow": ["a.md"], "files": {"a.md": "C:/Users/JoBloggs/x"}, "refused": "local path"},
    {"name": "private key", "allow": ["a.md"], "files": {"a.md": "-----BEGIN PRIVATE KEY-----"}, "refused": "private key"},
    {"name": "a link to an unpublished file is refused", "allow": ["a.md"], "files": {"a.md": "[b](b.md)", "b.md": "x"}, "refused": "links to b.md"},
    {"name": "links within the published set pass", "allow": ["a.md", "d/"], "files": {"a.md": "[b](d/b.md#x) [d](d/) [w](https://example.org)", "d/b.md": "[a](../a.md)"}, "published": ["a.md", "d/b.md"]},
    {"name": "a document with no Empower Your World link is refused", "require_link": "empoweryour.world", "allow": ["a.md"], "files": {"a.md": "x"}, "refused": "a.md: no empoweryour.world link"},
    {"name": "a document with the link passes; a script needs none", "require_link": "empoweryour.world", "allow": ["a.md", "b.ps1"], "files": {"a.md": "https://www.empoweryour.world/", "b.ps1": "x"}, "published": ["a.md", "b.ps1"]},
    {"name": "uncommitted changes are refused", "allow": ["a.md"], "files": {"a.md": "x"}, "dirty": true, "refused": "uncommitted"},
    {"name": "no forbidden values supplied is refused", "allow": ["a.md"], "files": {"a.md": "x"}, "no_forbid": true, "refused": "no forbidden values"},
    {"name": "the target is this repository", "allow": ["a.md"], "files": {"a.md": "x"}, "target": "self", "refused": "target"},
    {"name": "a target with the private history is refused", "allow": ["a.md"], "files": {"a.md": "x"}, "target": "shares-history", "refused": "shares history"},
    {"name": "a folder that isn't a git checkout is refused and left alone", "allow": ["a.md"], "files": {"a.md": "x"}, "target": "plain-folder", "refused": "target"},
    {"name": "a file no longer listed is removed from the target", "allow": ["a.md"], "files": {"a.md": "x"}, "target": "has-old-file", "published": ["a.md"]}
  ]
}
