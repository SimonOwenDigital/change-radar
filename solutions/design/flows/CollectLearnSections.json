{
  "properties": {
    "connectionReferences": {
      "shared_commondataserviceforapps": {
        "runtimeSource": "embedded",
        "connection": {
          "connectionReferenceLogicalName": "crdr_dataverse"
        },
        "api": {
          "name": "shared_commondataserviceforapps"
        }
      }
    },
    "definition": {
      "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
      "contentVersion": "1.0.0.0",
      "parameters": {
        "$connections": {
          "defaultValue": {},
          "type": "Object"
        },
        "$authentication": {
          "defaultValue": {},
          "type": "SecureObject"
        },
        "Tenant ID (crdr_tenantid)": {
          "defaultValue": "",
          "metadata": {
            "description": "Microsoft Entra tenant ID",
            "schemaName": "crdr_tenantid"
          },
          "type": "String"
        },
        "Reader client ID (crdr_readerclientid)": {
          "defaultValue": "",
          "metadata": {
            "description": "Application (client) ID of the crdr-reader app registration",
            "schemaName": "crdr_readerclientid"
          },
          "type": "String"
        }
      },
      "triggers": {
        "Recurrence": {
          "recurrence": {
            "frequency": "Day",
            "interval": 1,
            "schedule": {
              "hours": [
                "5"
              ],
              "minutes": [
                "20"
              ]
            }
          },
          "type": "Recurrence"
        }
      },
      "actions": {
        "List_config": {
          "type": "OpenApiConnection",
          "runAfter": {},
          "inputs": {
            "host": {
              "connectionName": "shared_commondataserviceforapps",
              "operationId": "ListRecords",
              "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps"
            },
            "parameters": {
              "$select": "crdr_key,crdr_value",
              "entityName": "crdr_configs"
            },
            "authentication": "@parameters('$authentication')"
          }
        },
        "Config_now_days": {
          "type": "Query",
          "runAfter": {
            "List_config": [
              "Succeeded"
            ]
          },
          "inputs": {
            "from": "@body('List_config')?['value']",
            "where": "@equals(item()?['crdr_key'], 'horizon_now_days')"
          }
        },
        "Config_imminent_days": {
          "type": "Query",
          "runAfter": {
            "List_config": [
              "Succeeded"
            ]
          },
          "inputs": {
            "from": "@body('List_config')?['value']",
            "where": "@equals(item()?['crdr_key'], 'horizon_imminent_days')"
          }
        },
        "Init_records": {
          "type": "InitializeVariable",
          "runAfter": {},
          "inputs": {
            "variables": [
              {
                "name": "records",
                "type": "string",
                "value": ""
              }
            ]
          }
        },
        "Init_gaps": {
          "type": "InitializeVariable",
          "runAfter": {
            "Init_records": [
              "Succeeded"
            ]
          },
          "inputs": {
            "variables": [
              {
                "name": "gaps",
                "type": "array",
                "value": []
              }
            ]
          }
        },
        "Init_failed": {
          "type": "InitializeVariable",
          "runAfter": {
            "Init_gaps": [
              "Succeeded"
            ]
          },
          "inputs": {
            "variables": [
              {
                "name": "failed",
                "type": "array",
                "value": []
              }
            ]
          }
        },
        "List_feeds": {
          "type": "OpenApiConnection",
          "runAfter": {
            "Config_imminent_days": [
              "Succeeded"
            ],
            "Config_now_days": [
              "Succeeded"
            ],
            "Init_failed": [
              "Succeeded"
            ]
          },
          "inputs": {
            "host": {
              "connectionName": "shared_commondataserviceforapps",
              "operationId": "ListRecords",
              "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps"
            },
            "parameters": {
              "$filter": "crdr_active eq true and crdr_kind eq 169890001",
              "$select": "crdr_feedid,crdr_key,crdr_name,crdr_url,crdr_products,crdr_profile,crdr_lastmarker",
              "entityName": "crdr_feeds"
            },
            "authentication": "@parameters('$authentication')"
          }
        },
        "Each_feed": {
          "type": "Foreach",
          "foreach": "@body('List_feeds')?['value']",
          "runAfter": {
            "List_feeds": [
              "Succeeded"
            ]
          },
          "runtimeConfiguration": {
            "concurrency": {
              "repetitions": 1
            }
          },
          "actions": {
            "Reset_records": {
              "type": "SetVariable",
              "runAfter": {},
              "inputs": {
                "name": "records",
                "value": ""
              }
            },
            "Reset_gaps": {
              "type": "SetVariable",
              "runAfter": {
                "Reset_records": [
                  "Succeeded"
                ]
              },
              "inputs": {
                "name": "gaps",
                "value": []
              }
            },
            "Collect": {
              "type": "Scope",
              "runAfter": {
                "Reset_gaps": [
                  "Succeeded"
                ]
              },
              "actions": {
                "Get_page": {
                  "type": "Http",
                  "runAfter": {},
                  "inputs": {
                    "method": "GET",
                    "uri": "@items('Each_feed')?['crdr_url']",
                    "headers": {
                      "User-Agent": "change-radar-collector/0.1"
                    }
                  }
                },
                "Page": {
                  "type": "Compose",
                  "runAfter": {
                    "Get_page": [
                      "Succeeded"
                    ]
                  },
                  "inputs": "@replace(replace(replace(replace(replace(replace(replace(replace(replace(replace(replace(replace(string(body('Get_page')), '&nbsp;', ' '), '&mdash;', ' '), '&ndash;', ' '), '&rsquo;', ' '), '&lsquo;', ' '), '&ldquo;', ' '), '&rdquo;', ' '), '&hellip;', ' '), '&copy;', ' '), '&reg;', ' '), '&trade;', ' '), '<br>', '<br/>')"
                },
                "Commit": {
                  "type": "Compose",
                  "runAfter": {
                    "Page": [
                      "Succeeded"
                    ]
                  },
                  "inputs": "@first(split(last(split(outputs('Page'), 'name=\"git_commit_id\" content=\"')), '\"'))"
                },
                "Profile": {
                  "type": "Compose",
                  "runAfter": {
                    "Commit": [
                      "Succeeded"
                    ]
                  },
                  "inputs": "@json(coalesce(items('Each_feed')?['crdr_profile'], '{}'))"
                },
                "Changed_page": {
                  "type": "Compose",
                  "runAfter": {
                    "Profile": [
                      "Succeeded"
                    ]
                  },
                  "inputs": "@not(equals(outputs('Commit'), coalesce(items('Each_feed')?['crdr_lastmarker'], '')))"
                },
                "Keywords": {
                  "type": "Compose",
                  "runAfter": {
                    "Changed_page": [
                      "Succeeded"
                    ]
                  },
                  "inputs": "@xml(concat('<k><w>', join(coalesce(outputs('Profile')?['titleKeywords'], json('[]')), '</w><w>'), '</w></k>'))"
                },
                "Chunks": {
                  "type": "Select",
                  "runAfter": {
                    "Keywords": [
                      "Succeeded"
                    ]
                  },
                  "inputs": {
                    "from": "@if(outputs('Changed_page'), skip(split(outputs('Page'), '<h2 id=\"'), 1), json('[]'))",
                    "select": {
                      "id": "@first(split(item(), '\"'))",
                      "body": "@item()"
                    }
                  }
                },
                "Dated": {
                  "type": "Query",
                  "runAfter": {
                    "Chunks": [
                      "Succeeded"
                    ]
                  },
                  "inputs": {
                    "from": "@body('Chunks')",
                    "where": "@and(equals(length(split(item()?['id'], '-')), 3), equals(length(last(split(item()?['id'], '-'))), 4), contains(json('[\"january\",\"february\",\"march\",\"april\",\"may\",\"june\",\"july\",\"august\",\"september\",\"october\",\"november\",\"december\"]'), first(split(item()?['id'], '-'))))"
                  }
                },
                "With_dates": {
                  "type": "Select",
                  "runAfter": {
                    "Dated": [
                      "Succeeded"
                    ]
                  },
                  "inputs": {
                    "from": "@body('Dated')",
                    "select": {
                      "id": "@item()?['id']",
                      "body": "@item()?['body']",
                      "date": "@formatDateTime(parseDateTime(concat(toUpper(substring(first(split(item()?['id'], '-')), 0, 1)), substring(first(split(item()?['id'], '-')), 1), ' ', split(item()?['id'], '-')[1], ', ', last(split(item()?['id'], '-'))), 'en-US', 'MMMM d, yyyy'), 'yyyy-MM-dd')"
                    }
                  }
                },
                "Recent": {
                  "type": "Query",
                  "runAfter": {
                    "With_dates": [
                      "Succeeded"
                    ]
                  },
                  "inputs": {
                    "from": "@body('With_dates')",
                    "where": "@greaterOrEquals(ticks(item()?['date']), ticks(addDays(startOfDay(utcNow()), mul(-1, int(coalesce(outputs('Profile')?['sinceDays'], 90))))))"
                  }
                },
                "Each_section": {
                  "type": "Foreach",
                  "foreach": "@body('Recent')",
                  "runAfter": {
                    "Recent": [
                      "Succeeded"
                    ]
                  },
                  "runtimeConfiguration": {
                    "concurrency": {
                      "repetitions": 1
                    }
                  },
                  "actions": {
                    "Try": {
                      "type": "Scope",
                      "runAfter": {},
                      "actions": {
                        "X": {
                          "type": "Compose",
                          "runAfter": {},
                          "inputs": "@xml(if(contains(items('Each_section')?['body'], '</ul>'), concat('<div><h2 id=\"', substring(items('Each_section')?['body'], 0, add(lastIndexOf(items('Each_section')?['body'], '</ul>'), 5)), '</div>'), '<div/>'))"
                        },
                        "Items": {
                          "type": "Select",
                          "runAfter": {
                            "X": [
                              "Succeeded"
                            ]
                          },
                          "inputs": {
                            "from": "@range(1, int(xpath(outputs('X'), 'count(/div/ul/li)')))",
                            "select": {
                              "title": "@xpath(outputs('X'), concat('normalize-space((/div/ul/li)[', string(item()), ']/p[1]/node()[1][self::strong])'))",
                              "area": "@xpath(outputs('X'), concat('normalize-space((/div/ul/li)[', string(item()), ']/../preceding-sibling::h3[1])'))",
                              "summary": "@xpath(outputs('X'), concat('normalize-space((/div/ul/li)[', string(item()), '])'))"
                            }
                          }
                        },
                        "In_scope": {
                          "type": "Query",
                          "runAfter": {
                            "Items": [
                              "Succeeded"
                            ]
                          },
                          "inputs": {
                            "from": "@body('Items')",
                            "where": "@and(not(equals(item()?['title'], '')), or(contains(coalesce(outputs('Profile')?['areas'], json('[]')), item()?['area']), greater(int(xpath(outputs('Keywords'), concat('count(/k/w[contains(''', replace(toLower(item()?['title']), '''', ' '), ''', .)])'))), 0)))"
                          }
                        },
                        "Section_records": {
                          "type": "Select",
                          "runAfter": {
                            "In_scope": [
                              "Succeeded"
                            ]
                          },
                          "inputs": {
                            "from": "@body('In_scope')",
                            "select": "@concat(items('Each_section')?['id'], '¶', items('Each_section')?['date'], '¶', item()?['area'], '¶', item()?['title'], '¶', item()?['summary'])"
                          }
                        },
                        "Add_records": {
                          "type": "AppendToStringVariable",
                          "runAfter": {
                            "Section_records": [
                              "Succeeded"
                            ]
                          },
                          "inputs": {
                            "name": "records",
                            "value": "@concat(join(body('Section_records'), '‖'), '‖')"
                          }
                        }
                      }
                    },
                    "Note_unreadable": {
                      "type": "AppendToArrayVariable",
                      "runAfter": {
                        "Try": [
                          "Failed",
                          "TimedOut"
                        ]
                      },
                      "inputs": {
                        "name": "gaps",
                        "value": "@concat('section ', items('Each_section')?['id'], ' could not be read')"
                      }
                    }
                  }
                },
                "Records": {
                  "type": "Query",
                  "runAfter": {
                    "Each_section": [
                      "Succeeded"
                    ]
                  },
                  "inputs": {
                    "from": "@split(variables('records'), '‖')",
                    "where": "@not(equals(item(), ''))"
                  }
                },
                "Parsed": {
                  "type": "Select",
                  "runAfter": {
                    "Records": [
                      "Succeeded"
                    ]
                  },
                  "inputs": {
                    "from": "@body('Records')",
                    "select": {
                      "sid": "@coalesce(split(item(), '¶')?[0], '')",
                      "date": "@coalesce(split(item(), '¶')?[1], '')",
                      "area": "@coalesce(split(item(), '¶')?[2], '')",
                      "title": "@coalesce(split(item(), '¶')?[3], '')",
                      "summary": "@coalesce(split(item(), '¶')?[4], '')",
                      "slug0": "@replace(replace(replace(replace(replace(replace(replace(replace(replace(replace(replace(replace(replace(replace(replace(replace(replace(replace(replace(replace(replace(replace(replace(replace(replace(replace(replace(replace(replace(replace(replace(replace(replace(toLower(coalesce(split(item(), '¶')?[3], '')), ' ', '-'), '.', '-'), '/', '-'), ',', '-'), '(', '-'), ')', '-'), ':', '-'), '''', '-'), '&', '-'), '+', '-'), '_', '-'), ';', '-'), '\"', '-'), '!', '-'), '?', '-'), '[', '-'), ']', '-'), '#', '-'), '*', '-'), '|', '-'), '>', '-'), '<', '-'), '%', '-'), '=', '-'), '@', '-'), '–', '-'), '—', '-'), '’', '-'), '‘', '-'), '--', '-'), '--', '-'), '--', '-'), '--', '-')"
                    }
                  }
                },
                "Keyed": {
                  "type": "Select",
                  "runAfter": {
                    "Parsed": [
                      "Succeeded"
                    ]
                  },
                  "inputs": {
                    "from": "@body('Parsed')",
                    "select": {
                      "sid": "@item()?['sid']",
                      "date": "@item()?['date']",
                      "area": "@item()?['area']",
                      "title": "@item()?['title']",
                      "summary": "@item()?['summary']",
                      "idcut": "@substring(concat(items('Each_feed')?['crdr_key'], '-', replace(item()?['date'], '-', ''), '-', if(endsWith(if(startsWith(item()?['slug0'], '-'), substring(item()?['slug0'], 1), item()?['slug0']), '-'), substring(if(startsWith(item()?['slug0'], '-'), substring(item()?['slug0'], 1), item()?['slug0']), 0, sub(length(if(startsWith(item()?['slug0'], '-'), substring(item()?['slug0'], 1), item()?['slug0'])), 1)), if(startsWith(item()?['slug0'], '-'), substring(item()?['slug0'], 1), item()?['slug0']))), 0, min(100, length(concat(items('Each_feed')?['crdr_key'], '-', replace(item()?['date'], '-', ''), '-', if(endsWith(if(startsWith(item()?['slug0'], '-'), substring(item()?['slug0'], 1), item()?['slug0']), '-'), substring(if(startsWith(item()?['slug0'], '-'), substring(item()?['slug0'], 1), item()?['slug0']), 0, sub(length(if(startsWith(item()?['slug0'], '-'), substring(item()?['slug0'], 1), item()?['slug0'])), 1)), if(startsWith(item()?['slug0'], '-'), substring(item()?['slug0'], 1), item()?['slug0']))))))"
                    }
                  }
                },
                "Shaped": {
                  "type": "Select",
                  "runAfter": {
                    "Keyed": [
                      "Succeeded"
                    ]
                  },
                  "inputs": {
                    "from": "@body('Keyed')",
                    "select": {
                      "externalid": "@if(endsWith(item()?['idcut'], '-'), substring(item()?['idcut'], 0, sub(length(item()?['idcut']), 1)), item()?['idcut'])",
                      "key": "@concat(if(endsWith(item()?['idcut'], '-'), substring(item()?['idcut'], 0, sub(length(item()?['idcut']), 1)), item()?['idcut']), '|', if(empty(item()?['date']), '', formatDateTime(item()?['date'], 'yyyy-MM-ddTHH:mm:ss')))",
                      "title": "@if(greater(length(coalesce(item()?['title'], '')), 400), substring(item()?['title'], 0, 400), coalesce(item()?['title'], ''))",
                      "summary": "@if(greater(length(coalesce(item()?['summary'], '')), 20000), substring(item()?['summary'], 0, 20000), coalesce(item()?['summary'], ''))",
                      "products": "@if(greater(length(coalesce(coalesce(outputs('Profile')?['areaProducts']?[item()?['area']], items('Each_feed')?['crdr_products']), '')), 400), substring(coalesce(outputs('Profile')?['areaProducts']?[item()?['area']], items('Each_feed')?['crdr_products']), 0, 400), coalesce(coalesce(outputs('Profile')?['areaProducts']?[item()?['area']], items('Each_feed')?['crdr_products']), ''))",
                      "horizon": 169890002,
                      "keydate": "@item()?['date']",
                      "datelabel": "@if(greater(length(coalesce(concat('Released · ', item()?['area']), '')), 100), substring(concat('Released · ', item()?['area']), 0, 100), coalesce(concat('Released · ', item()?['area']), ''))",
                      "actionrequired": false,
                      "url": "@concat(items('Each_feed')?['crdr_url'], '#', item()?['sid'])",
                      "lastchanged": "@item()?['date']",
                      "snapshot": "@if(greater(length(coalesce(string(item()), '')), 100000), substring(string(item()), 0, 100000), coalesce(string(item()), ''))"
                    }
                  }
                },
                "Id_list": {
                  "type": "Select",
                  "runAfter": {
                    "Shaped": [
                      "Succeeded"
                    ]
                  },
                  "inputs": {
                    "from": "@body('Shaped')",
                    "select": "@item()?['externalid']"
                  }
                },
                "Ids": {
                  "type": "Compose",
                  "runAfter": {
                    "Id_list": [
                      "Succeeded"
                    ]
                  },
                  "inputs": "@xml(concat('<r><i>', join(body('Id_list'), '</i><i>'), '</i></r>'))"
                },
                "First_ids": {
                  "type": "Query",
                  "runAfter": {
                    "Ids": [
                      "Succeeded"
                    ]
                  },
                  "inputs": {
                    "from": "@range(0, length(body('Shaped')))",
                    "where": "@equals(int(xpath(outputs('Ids'), concat('count(/r/i[position() < ', string(add(item(), 1)), '][. = ''', body('Id_list')[item()], '''])'))), 0)"
                  }
                },
                "Shape": {
                  "type": "Select",
                  "runAfter": {
                    "First_ids": [
                      "Succeeded"
                    ]
                  },
                  "inputs": {
                    "from": "@body('First_ids')",
                    "select": "@body('Shaped')[item()]"
                  }
                },
                "List_existing": {
                  "type": "OpenApiConnection",
                  "runAfter": {
                    "Shape": [
                      "Succeeded"
                    ]
                  },
                  "inputs": {
                    "host": {
                      "connectionName": "shared_commondataserviceforapps",
                      "operationId": "ListRecords",
                      "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps"
                    },
                    "parameters": {
                      "$filter": "@concat('crdr_source eq 169890006 and _crdr_feed_value eq ', items('Each_feed')?['crdr_feedid'])",
                      "$select": "crdr_signalid,crdr_externalid,crdr_lastchanged,crdr_title,crdr_keydate,crdr_datelabel,crdr_horizon,crdr_actionrequired",
                      "entityName": "crdr_signals"
                    },
                    "authentication": "@parameters('$authentication')"
                  },
                  "runtimeConfiguration": {
                    "paginationPolicy": {
                      "minimumItemCount": 100000
                    }
                  }
                },
                "Existing_keys": {
                  "type": "Select",
                  "runAfter": {
                    "List_existing": [
                      "Succeeded"
                    ]
                  },
                  "inputs": {
                    "from": "@body('List_existing')?['value']",
                    "select": "@concat(item()?['crdr_externalid'], '|', if(empty(item()?['crdr_lastchanged']), '', formatDateTime(item()?['crdr_lastchanged'], 'yyyy-MM-ddTHH:mm:ss')))"
                  }
                },
                "Changed": {
                  "type": "Query",
                  "runAfter": {
                    "Existing_keys": [
                      "Succeeded"
                    ]
                  },
                  "inputs": {
                    "from": "@body('Shape')",
                    "where": "@not(contains(body('Existing_keys'), item()?['key']))"
                  }
                },
                "Upsert": {
                  "type": "Foreach",
                  "foreach": "@body('Changed')",
                  "runAfter": {
                    "Changed": [
                      "Succeeded"
                    ]
                  },
                  "runtimeConfiguration": {
                    "concurrency": {
                      "repetitions": 10
                    }
                  },
                  "actions": {
                    "Find_existing": {
                      "type": "Query",
                      "runAfter": {},
                      "inputs": {
                        "from": "@body('List_existing')?['value']",
                        "where": "@equals(item()?['crdr_externalid'], items('Upsert')?['externalid'])"
                      }
                    },
                    "Is_new": {
                      "type": "If",
                      "runAfter": {
                        "Find_existing": [
                          "Succeeded"
                        ]
                      },
                      "expression": {
                        "equals": [
                          "@empty(body('Find_existing'))",
                          true
                        ]
                      },
                      "actions": {
                        "Create_signal": {
                          "type": "OpenApiConnection",
                          "runAfter": {},
                          "inputs": {
                            "host": {
                              "connectionName": "shared_commondataserviceforapps",
                              "operationId": "CreateRecord",
                              "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps"
                            },
                            "parameters": {
                              "entityName": "crdr_signals",
                              "item/crdr_actionrequired": "@items('Upsert')?['actionrequired']",
                              "item/crdr_datelabel": "@items('Upsert')?['datelabel']",
                              "item/crdr_externalid": "@items('Upsert')?['externalid']",
                              "item/crdr_feed@odata.bind": "@concat('/crdr_feeds(', items('Each_feed')?['crdr_feedid'], ')')",
                              "item/crdr_firstseen": "@utcNow()",
                              "item/crdr_horizon": "@items('Upsert')?['horizon']",
                              "item/crdr_keydate": "@items('Upsert')?['keydate']",
                              "item/crdr_lastchanged": "@items('Upsert')?['lastchanged']",
                              "item/crdr_products": "@items('Upsert')?['products']",
                              "item/crdr_source": 169890006,
                              "item/crdr_summary": "@items('Upsert')?['summary']",
                              "item/crdr_title": "@items('Upsert')?['title']",
                              "item/crdr_url": "@items('Upsert')?['url']"
                            },
                            "authentication": "@parameters('$authentication')"
                          }
                        },
                        "Create_version": {
                          "type": "OpenApiConnection",
                          "runAfter": {
                            "Create_signal": [
                              "Succeeded"
                            ]
                          },
                          "inputs": {
                            "host": {
                              "connectionName": "shared_commondataserviceforapps",
                              "operationId": "CreateRecord",
                              "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps"
                            },
                            "parameters": {
                              "entityName": "crdr_signalversions",
                              "item/crdr_capturedon": "@utcNow()",
                              "item/crdr_changedfields": "created",
                              "item/crdr_name": "@concat(items('Upsert')?['externalid'], ' ', items('Upsert')?['lastchanged'])",
                              "item/crdr_signal@odata.bind": "@concat('/crdr_signals(', body('Create_signal')?['crdr_signalid'], ')')",
                              "item/crdr_snapshotjson": "@items('Upsert')?['snapshot']"
                            },
