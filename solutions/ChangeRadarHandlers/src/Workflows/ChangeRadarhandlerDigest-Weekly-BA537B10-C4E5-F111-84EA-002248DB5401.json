          "inputs": {
            "type": "AdaptiveCard",
            "$schema": "http://adaptivecards.io/schemas/adaptive-card.json",
            "version": "1.4",
            "body": [
              {
                "type": "TextBlock",
                "text": "Change Radar weekly digest",
                "weight": "Bolder",
                "size": "Medium",
                "wrap": true
              },
              {
                "type": "TextBlock",
                "text": "@concat('Your live estate, week to ', formatDateTime(utcNow(), 'yyyy-MM-dd'), '. Incidents, High and Critical ratings and deadlines were sent as they happened.')",
                "isSubtle": true,
                "wrap": true
              },
              {
                "type": "TextBlock",
                "text": "@outputs('Digest_text')",
                "wrap": true
              }
            ],
            "actions": "@createArray(addProperty(addProperty(addProperty(json('{}'), 'type', 'Action.OpenUrl'), 'title', 'Open Change Radar'), 'url', coalesce(first(body('Config_app'))?['crdr_value'], '')))"
          }
        },
        "If_anything": {
          "type": "If",
          "runAfter": {
            "Digest_card": [
              "Succeeded"
            ]
          },
          "expression": {
            "equals": [
              "@empty(body('Queued')?['value'])",
              false
            ]
          },
          "actions": {
            "My_dests": {
              "type": "Query",
              "runAfter": {},
              "inputs": {
                "from": "@outputs('Destinations')",
                "where": "@or(equals(item()?['kind'], 'chat'), equals(item()?['kind'], 'channel'))"
              }
            },
            "Bad_dests": {
              "type": "Query",
              "runAfter": {
                "My_dests": [
                  "Succeeded"
                ]
              },
              "inputs": {
                "from": "@outputs('Destinations')",
                "where": "@equals(item()?['kind'], 'invalid')"
              }
            },
            "Each_dest": {
              "type": "Foreach",
              "foreach": "@body('My_dests')",
              "runAfter": {
                "Bad_dests": [
                  "Succeeded"
                ]
              },
              "runtimeConfiguration": {
                "concurrency": {
                  "repetitions": 1
                }
              },
              "actions": {
                "Send": {
                  "type": "Scope",
                  "runAfter": {},
                  "actions": {
                    "If_chat": {
                      "type": "If",
                      "runAfter": {},
                      "expression": {
                        "equals": [
                          "@items('Each_dest')?['kind']",
                          "chat"
                        ]
                      },
                      "actions": {
                        "Post_chat": {
                          "type": "OpenApiConnection",
                          "runAfter": {},
                          "inputs": {
                            "host": {
                              "connectionName": "shared_teams",
                              "operationId": "PostCardToConversation",
                              "apiId": "/providers/Microsoft.PowerApps/apis/shared_teams"
                            },
                            "parameters": {
                              "poster": "Flow bot",
                              "location": "Chat with Flow bot",
                              "body/recipient": "@items('Each_dest')?['address']",
                              "body/messageBody": "@string(outputs('Digest_card'))"
                            },
                            "authentication": "@parameters('$authentication')"
                          }
                        }
                      },
                      "else": {
                        "actions": {
                          "Post_channel": {
                            "type": "OpenApiConnection",
                            "runAfter": {},
                            "inputs": {
                              "host": {
                                "connectionName": "shared_teams",
                                "operationId": "PostCardToConversation",
                                "apiId": "/providers/Microsoft.PowerApps/apis/shared_teams"
                              },
                              "parameters": {
                                "poster": "Flow bot",
                                "location": "Channel",
                                "body/recipient/groupId": "@items('Each_dest')?['teamId']",
                                "body/recipient/channelId": "@items('Each_dest')?['channelId']",
                                "body/messageBody": "@string(outputs('Digest_card'))"
                              },
                              "authentication": "@parameters('$authentication')"
                            }
                          }
                        }
                      }
                    }
                  }
                },
                "Note_sent": {
                  "type": "AppendToArrayVariable",
                  "runAfter": {
                    "Send": [
                      "Succeeded"
                    ]
                  },
                  "inputs": {
                    "name": "results",
                    "value": {
                      "to": "@if(equals(items('Each_dest')?['kind'], 'channel'), concat('channel:', items('Each_dest')?['teamId'], '/', items('Each_dest')?['channelId']), concat(items('Each_dest')?['kind'], ':', items('Each_dest')?['address']))",
                      "ok": true,
                      "error": ""
                    }
                  }
                },
                "Note_failed": {
                  "type": "AppendToArrayVariable",
                  "runAfter": {
                    "Send": [
                      "Failed",
                      "TimedOut"
                    ]
                  },
                  "inputs": {
                    "name": "results",
                    "value": {
                      "to": "@if(equals(items('Each_dest')?['kind'], 'channel'), concat('channel:', items('Each_dest')?['teamId'], '/', items('Each_dest')?['channelId']), concat(items('Each_dest')?['kind'], ':', items('Each_dest')?['address']))",
                      "ok": false,
                      "error": "@if(greater(length(coalesce(string(coalesce(actions('Post_chat')?['outputs']?['body']?['error']?['message'], actions('Post_channel')?['outputs']?['body']?['error']?['message'], actions('Post_chat')?['error']?['message'], actions('Post_channel')?['error']?['message'], 'the post failed')), '')), 300), substring(string(coalesce(actions('Post_chat')?['outputs']?['body']?['error']?['message'], actions('Post_channel')?['outputs']?['body']?['error']?['message'], actions('Post_chat')?['error']?['message'], actions('Post_channel')?['error']?['message'], 'the post failed')), 0, 300), coalesce(string(coalesce(actions('Post_chat')?['outputs']?['body']?['error']?['message'], actions('Post_channel')?['outputs']?['body']?['error']?['message'], actions('Post_chat')?['error']?['message'], actions('Post_channel')?['error']?['message'], 'the post failed')), ''))"
                    }
                  }
                }
              }
            },
            "Failed_sends": {
              "type": "Query",
              "runAfter": {
                "Each_dest": [
                  "Succeeded",
                  "Failed",
                  "Skipped",
                  "TimedOut"
                ]
              },
              "inputs": {
                "from": "@variables('results')",
                "where": "@equals(item()?['ok'], false)"
              }
            },
            "Failed_text": {
              "type": "Select",
              "runAfter": {
                "Failed_sends": [
                  "Succeeded"
                ]
              },
              "inputs": {
                "from": "@body('Failed_sends')",
                "select": "@concat(item()?['to'], ' (', item()?['error'], ')')"
              }
            },
            "Bad_text": {
              "type": "Select",
              "runAfter": {
                "Failed_text": [
                  "Succeeded"
                ]
              },
              "inputs": {
                "from": "@body('Bad_dests')",
                "select": "@concat(item()?['entry'], ' (', item()?['reason'], ')')"
              }
            },
            "Delivery": {
              "type": "Compose",
              "runAfter": {
                "Bad_text": [
                  "Succeeded"
                ]
              },
              "inputs": {
                "sent": "@sub(length(body('My_dests')), length(body('Failed_sends')))",
                "ok": "@and(greater(length(body('My_dests')), 0), equals(length(body('Failed_sends')), 0), empty(body('Bad_dests')))",
                "text": "@concat(if(equals(length(body('My_dests')), 0), 'No Teams destination in alert_destinations or alert_recipient: nothing was sent.', concat('Sent to ', string(sub(length(body('My_dests')), length(body('Failed_sends')))), ' of ', string(length(body('My_dests'))), ' Teams destination', if(equals(length(body('My_dests')), 1), '', 's'), '.')), if(equals(length(body('Failed_sends')), 0), '', concat(' Failed: ', join(body('Failed_text'), '; '), '.')), if(empty(body('Bad_dests')), '', concat(' Invalid entries in alert_destinations: ', join(body('Bad_text'), '; '), '.')))"
              }
            },
            "If_delivered": {
              "type": "If",
              "runAfter": {
                "Delivery": [
                  "Succeeded"
                ]
              },
              "expression": {
                "greater": [
                  "@outputs('Delivery')?['sent']",
                  0
                ]
              },
              "actions": {
                "Each_included": {
                  "type": "Foreach",
                  "foreach": "@body('Queued')?['value']",
                  "runAfter": {},
                  "actions": {
                    "Mark_included": {
                      "type": "OpenApiConnection",
                      "runAfter": {},
                      "inputs": {
                        "host": {
                          "connectionName": "shared_commondataserviceforapps",
                          "operationId": "UpdateRecord",
                          "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps"
                        },
                        "parameters": {
                          "entityName": "crdr_handlerruns",
                          "item/crdr_detail": "@if(greater(length(coalesce(concat('Included in the digest of ', formatDateTime(utcNow(), 'yyyy-MM-dd'), '. ', outputs('Delivery')?['text']), '')), 4000), substring(concat('Included in the digest of ', formatDateTime(utcNow(), 'yyyy-MM-dd'), '. ', outputs('Delivery')?['text']), 0, 4000), coalesce(concat('Included in the digest of ', formatDateTime(utcNow(), 'yyyy-MM-dd'), '. ', outputs('Delivery')?['text']), ''))",
                          "item/crdr_outcome": "@if(outputs('Delivery')?['ok'], 169890000, 169890002)",
                          "item/crdr_ranon": "@utcNow()",
                          "recordId": "@items('Each_included')?['crdr_handlerrunid']"
                        },
                        "authentication": "@parameters('$authentication')"
                      }
                    }
                  }
                }
              },
              "else": {
                "actions": {}
              }
            }
          },
          "else": {
            "actions": {}
          }
        }
      },
      "description": "Change Radar handler Digest-Weekly: every Monday, one card summarising the week's queued digest runs (new and changed signals, exposures, ratings) to each chat: and channel: entry in alert_destinations (and alert_recipient). Posts only (writes = no; ADR 0011 and its addendum)."
    },
    "templateName": ""
  },
  "schemaVersion": "1.0.0.0"
}