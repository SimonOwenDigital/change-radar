{
  "properties": {
    "connectionReferences": {
      "shared_commondataserviceforapps": {
        "runtimeSource": "embedded",
        "connection": {
          "connectionReferenceLogicalName": "crdr_dataverse"
        },
        "api": {
          "name": "shared_commondataserviceforapps"
        }
      }
    },
    "definition": {
      "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
      "contentVersion": "1.0.0.0",
      "parameters": {
        "$connections": {
          "defaultValue": {},
          "type": "Object"
        },
        "$authentication": {
          "defaultValue": {},
          "type": "SecureObject"
        },
        "Tenant ID (crdr_tenantid)": {
          "defaultValue": "",
          "metadata": {
            "description": "Microsoft Entra tenant ID",
            "schemaName": "crdr_tenantid"
          },
          "type": "String"
        },
        "Reader client ID (crdr_readerclientid)": {
          "defaultValue": "",
          "metadata": {
            "description": "Application (client) ID of the crdr-reader app registration",
            "schemaName": "crdr_readerclientid"
          },
          "type": "String"
        }
      },
      "triggers": {
        "Recurrence": {
          "recurrence": {
            "frequency": "Day",
            "interval": 1,
            "schedule": {
              "hours": [
                "5"
              ],
              "minutes": [
                "25"
              ]
            }
          },
          "type": "Recurrence"
        }
      },
      "actions": {
        "List_config": {
          "type": "OpenApiConnection",
          "runAfter": {},
          "inputs": {
            "host": {
              "connectionName": "shared_commondataserviceforapps",
              "operationId": "ListRecords",
              "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps"
            },
            "parameters": {
              "$select": "crdr_key,crdr_value",
              "entityName": "crdr_configs"
            },
            "authentication": "@parameters('$authentication')"
          }
        },
        "Config_now_days": {
          "type": "Query",
          "runAfter": {
            "List_config": [
              "Succeeded"
            ]
          },
          "inputs": {
            "from": "@body('List_config')?['value']",
            "where": "@equals(item()?['crdr_key'], 'horizon_now_days')"
          }
        },
        "Config_imminent_days": {
          "type": "Query",
          "runAfter": {
            "List_config": [
              "Succeeded"
            ]
          },
          "inputs": {
            "from": "@body('List_config')?['value']",
            "where": "@equals(item()?['crdr_key'], 'horizon_imminent_days')"
          }
        },
        "Init_records": {
          "type": "InitializeVariable",
          "runAfter": {},
          "inputs": {
            "variables": [
              {
                "name": "records",
                "type": "string",
                "value": ""
              }
            ]
          }
        },
        "Init_gaps": {
          "type": "InitializeVariable",
          "runAfter": {
            "Init_records": [
              "Succeeded"
            ]
          },
          "inputs": {
            "variables": [
              {
                "name": "gaps",
                "type": "array",
                "value": []
              }
            ]
          }
        },
        "Init_failed": {
          "type": "InitializeVariable",
          "runAfter": {
            "Init_gaps": [
              "Succeeded"
            ]
          },
          "inputs": {
            "variables": [
              {
                "name": "failed",
                "type": "array",
                "value": []
              }
            ]
          }
        },
        "List_feeds": {
          "type": "OpenApiConnection",
          "runAfter": {
            "Config_imminent_days": [
              "Succeeded"
            ],
            "Config_now_days": [
              "Succeeded"
            ],
            "Init_failed": [
              "Succeeded"
            ]
          },
          "inputs": {
            "host": {
              "connectionName": "shared_commondataserviceforapps",
              "operationId": "ListRecords",
              "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps"
            },
            "parameters": {
              "$filter": "crdr_active eq true and crdr_kind eq 169890002",
              "$select": "crdr_feedid,crdr_key,crdr_name,crdr_url,crdr_products,crdr_profile,crdr_lastmarker",
              "entityName": "crdr_feeds"
            },
            "authentication": "@parameters('$authentication')"
          }
        },
        "Each_feed": {
          "type": "Foreach",
          "foreach": "@body('List_feeds')?['value']",
          "runAfter": {
            "List_feeds": [
              "Succeeded"
            ]
          },
          "runtimeConfiguration": {
            "concurrency": {
              "repetitions": 1
            }
          },
          "actions": {
            "Reset_records": {
              "type": "SetVariable",
              "runAfter": {},
              "inputs": {
                "name": "records",
                "value": ""
              }
            },
            "Reset_gaps": {
              "type": "SetVariable",
              "runAfter": {
                "Reset_records": [
                  "Succeeded"
                ]
              },
              "inputs": {
                "name": "gaps",
                "value": []
              }
            },
            "Collect": {
              "type": "Scope",
              "runAfter": {
                "Reset_gaps": [
                  "Succeeded"
                ]
              },
              "actions": {
                "Get_page": {
                  "type": "Http",
                  "runAfter": {},
                  "inputs": {
                    "method": "GET",
                    "uri": "@items('Each_feed')?['crdr_url']",
                    "headers": {
                      "User-Agent": "change-radar-collector/0.1"
                    }
                  }
                },
                "X": {
                  "type": "Compose",
                  "runAfter": {
                    "Get_page": [
                      "Succeeded"
                    ]
                  },
                  "inputs": "@xml(string(body('Get_page')))"
                },
                "Profile": {
                  "type": "Compose",
                  "runAfter": {
                    "X": [
                      "Succeeded"
                    ]
                  },
                  "inputs": "@json(coalesce(items('Each_feed')?['crdr_profile'], '{}'))"
                },
                "Items": {
                  "type": "Select",
                  "runAfter": {
                    "Profile": [
                      "Succeeded"
                    ]
                  },
                  "inputs": {
                    "from": "@range(1, int(xpath(outputs('X'), 'count(/rss/channel/item)')))",
                    "select": {
                      "title": "@trim(xpath(outputs('X'), concat('string(/rss/channel/item[', string(item()), ']/title)')))",
                      "link": "@trim(xpath(outputs('X'), concat('string(/rss/channel/item[', string(item()), ']/link)')))",
                      "pub": "@formatDateTime(xpath(outputs('X'), concat('string(/rss/channel/item[', string(item()), ']/pubDate)')), 'yyyy-MM-ddTHH:mm:ssZ')",
                      "description": "@xpath(outputs('X'), concat('string(/rss/channel/item[', string(item()), ']/description)'))"
                    }
                  }
                },
                "Marker": {
                  "type": "Compose",
                  "runAfter": {
                    "Items": [
                      "Succeeded"
                    ]
                  },
                  "inputs": "@coalesce(first(body('Items'))?['pub'], '')"
                },
                "Changed_page": {
                  "type": "Compose",
                  "runAfter": {
                    "Marker": [
                      "Succeeded"
                    ]
                  },
                  "inputs": "@and(not(equals(outputs('Marker'), '')), greater(ticks(outputs('Marker')), ticks(if(equals(coalesce(items('Each_feed')?['crdr_lastmarker'], ''), ''), '1900-01-01T00:00:00Z', items('Each_feed')?['crdr_lastmarker']))))"
                },
                "Slugged": {
                  "type": "Select",
                  "runAfter": {
                    "Changed_page": [
                      "Succeeded"
                    ]
                  },
                  "inputs": {
                    "from": "@if(outputs('Changed_page'), body('Items'), json('[]'))",
                    "select": {
                      "title": "@item()?['title']",
                      "link": "@item()?['link']",
                      "pub": "@item()?['pub']",
                      "description": "@item()?['description']",
                      "slug": "@if(endsWith(replace(replace(replace(replace(replace(replace(replace(replace(replace(replace(replace(replace(replace(replace(replace(replace(replace(replace(replace(replace(replace(replace(replace(replace(replace(replace(replace(replace(toLower(last(split(if(endsWith(item()?['link'], '/'), substring(item()?['link'], 0, sub(length(item()?['link']), 1)), item()?['link']), '/'))), ' ', '-'), '.', '-'), '/', '-'), ',', '-'), '(', '-'), ')', '-'), ':', '-'), '''', '-'), '&', '-'), '+', '-'), '_', '-'), ';', '-'), '\"', '-'), '!', '-'), '?', '-'), '[', '-'), ']', '-'), '#', '-'), '*', '-'), '|', '-'), '–', '-'), '—', '-'), '’', '-'), '‘', '-'), '--', '-'), '--', '-'), '--', '-'), '--', '-'), '-'), substring(replace(replace(replace(replace(replace(replace(replace(replace(replace(replace(replace(replace(replace(replace(replace(replace(replace(replace(replace(replace(replace(replace(replace(replace(replace(replace(replace(replace(toLower(last(split(if(endsWith(item()?['link'], '/'), substring(item()?['link'], 0, sub(length(item()?['link']), 1)), item()?['link']), '/'))), ' ', '-'), '.', '-'), '/', '-'), ',', '-'), '(', '-'), ')', '-'), ':', '-'), '''', '-'), '&', '-'), '+', '-'), '_', '-'), ';', '-'), '\"', '-'), '!', '-'), '?', '-'), '[', '-'), ']', '-'), '#', '-'), '*', '-'), '|', '-'), '–', '-'), '—', '-'), '’', '-'), '‘', '-'), '--', '-'), '--', '-'), '--', '-'), '--', '-'), 0, sub(length(replace(replace(replace(replace(replace(replace(replace(replace(replace(replace(replace(replace(replace(replace(replace(replace(replace(replace(replace(replace(replace(replace(replace(replace(replace(replace(replace(replace(toLower(last(split(if(endsWith(item()?['link'], '/'), substring(item()?['link'], 0, sub(length(item()?['link']), 1)), item()?['link']), '/'))), ' ', '-'), '.', '-'), '/', '-'), ',', '-'), '(', '-'), ')', '-'), ':', '-'), '''', '-'), '&', '-'), '+', '-'), '_', '-'), ';', '-'), '\"', '-'), '!', '-'), '?', '-'), '[', '-'), ']', '-'), '#', '-'), '*', '-'), '|', '-'), '–', '-'), '—', '-'), '’', '-'), '‘', '-'), '--', '-'), '--', '-'), '--', '-'), '--', '-')), 1)), replace(replace(replace(replace(replace(replace(replace(replace(replace(replace(replace(replace(replace(replace(replace(replace(replace(replace(replace(replace(replace(replace(replace(replace(replace(replace(replace(replace(toLower(last(split(if(endsWith(item()?['link'], '/'), substring(item()?['link'], 0, sub(length(item()?['link']), 1)), item()?['link']), '/'))), ' ', '-'), '.', '-'), '/', '-'), ',', '-'), '(', '-'), ')', '-'), ':', '-'), '''', '-'), '&', '-'), '+', '-'), '_', '-'), ';', '-'), '\"', '-'), '!', '-'), '?', '-'), '[', '-'), ']', '-'), '#', '-'), '*', '-'), '|', '-'), '–', '-'), '—', '-'), '’', '-'), '‘', '-'), '--', '-'), '--', '-'), '--', '-'), '--', '-'))"
                    }
                  }
                },
                "Shaped": {
                  "type": "Select",
                  "runAfter": {
                    "Slugged": [
                      "Succeeded"
                    ]
                  },
                  "inputs": {
                    "from": "@body('Slugged')",
                    "select": {
                      "externalid": "@if(endsWith(substring(concat(items('Each_feed')?['crdr_key'], '-', item()?['slug']), 0, min(100, length(concat(items('Each_feed')?['crdr_key'], '-', item()?['slug'])))), '-'), substring(substring(concat(items('Each_feed')?['crdr_key'], '-', item()?['slug']), 0, min(100, length(concat(items('Each_feed')?['crdr_key'], '-', item()?['slug'])))), 0, sub(length(substring(concat(items('Each_feed')?['crdr_key'], '-', item()?['slug']), 0, min(100, length(concat(items('Each_feed')?['crdr_key'], '-', item()?['slug']))))), 1)), substring(concat(items('Each_feed')?['crdr_key'], '-', item()?['slug']), 0, min(100, length(concat(items('Each_feed')?['crdr_key'], '-', item()?['slug'])))))",
                      "key": "@concat(if(endsWith(substring(concat(items('Each_feed')?['crdr_key'], '-', item()?['slug']), 0, min(100, length(concat(items('Each_feed')?['crdr_key'], '-', item()?['slug'])))), '-'), substring(substring(concat(items('Each_feed')?['crdr_key'], '-', item()?['slug']), 0, min(100, length(concat(items('Each_feed')?['crdr_key'], '-', item()?['slug'])))), 0, sub(length(substring(concat(items('Each_feed')?['crdr_key'], '-', item()?['slug']), 0, min(100, length(concat(items('Each_feed')?['crdr_key'], '-', item()?['slug']))))), 1)), substring(concat(items('Each_feed')?['crdr_key'], '-', item()?['slug']), 0, min(100, length(concat(items('Each_feed')?['crdr_key'], '-', item()?['slug']))))), '|', if(empty(item()?['pub']), '', formatDateTime(item()?['pub'], 'yyyy-MM-ddTHH:mm:ss')))",
                      "title": "@if(greater(length(coalesce(item()?['title'], '')), 400), substring(item()?['title'], 0, 400), coalesce(item()?['title'], ''))",
                      "summary": "@if(greater(length(coalesce(item()?['description'], '')), 20000), substring(item()?['description'], 0, 20000), coalesce(item()?['description'], ''))",
                      "products": "@if(greater(length(coalesce(items('Each_feed')?['crdr_products'], '')), 400), substring(items('Each_feed')?['crdr_products'], 0, 400), coalesce(items('Each_feed')?['crdr_products'], ''))",
                      "horizon": 169890002,
                      "keydate": "@item()?['pub']",
                      "datelabel": "@if(greater(length(coalesce(concat(coalesce(outputs('Profile')?['label'], 'Feed'), ' · published'), '')), 100), substring(concat(coalesce(outputs('Profile')?['label'], 'Feed'), ' · published'), 0, 100), coalesce(concat(coalesce(outputs('Profile')?['label'], 'Feed'), ' · published'), ''))",
                      "actionrequired": false,
                      "url": "@item()?['link']",
                      "lastchanged": "@item()?['pub']",
                      "snapshot": "@if(greater(length(coalesce(string(item()), '')), 100000), substring(string(item()), 0, 100000), coalesce(string(item()), ''))"
                    }
                  }
                },
                "Shape": {
                  "type": "Query",
                  "runAfter": {
                    "Shaped": [
                      "Succeeded"
                    ]
                  },
                  "inputs": {
                    "from": "@body('Shaped')",
                    "where": "@true"
                  }
                },
                "List_existing": {
                  "type": "OpenApiConnection",
                  "runAfter": {
                    "Shape": [
                      "Succeeded"
                    ]
                  },
                  "inputs": {
                    "host": {
                      "connectionName": "shared_commondataserviceforapps",
                      "operationId": "ListRecords",
                      "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps"
                    },
                    "parameters": {
                      "$filter": "@concat('crdr_source eq 169890006 and _crdr_feed_value eq ', items('Each_feed')?['crdr_feedid'])",
                      "$select": "crdr_signalid,crdr_externalid,crdr_lastchanged,crdr_title,crdr_keydate,crdr_datelabel,crdr_horizon,crdr_actionrequired",
                      "entityName": "crdr_signals"
                    },
                    "authentication": "@parameters('$authentication')"
                  },
                  "runtimeConfiguration": {
                    "paginationPolicy": {
                      "minimumItemCount": 100000
                    }
                  }
                },
                "Existing_keys": {
                  "type": "Select",
                  "runAfter": {
                    "List_existing": [
                      "Succeeded"
                    ]
                  },
                  "inputs": {
                    "from": "@body('List_existing')?['value']",
                    "select": "@concat(item()?['crdr_externalid'], '|', if(empty(item()?['crdr_lastchanged']), '', formatDateTime(item()?['crdr_lastchanged'], 'yyyy-MM-ddTHH:mm:ss')))"
                  }
                },
                "Changed": {
                  "type": "Query",
                  "runAfter": {
                    "Existing_keys": [
                      "Succeeded"
                    ]
                  },
                  "inputs": {
                    "from": "@body('Shape')",
                    "where": "@not(contains(body('Existing_keys'), item()?['key']))"
                  }
                },
                "Upsert": {
                  "type": "Foreach",
                  "foreach": "@body('Changed')",
                  "runAfter": {
                    "Changed": [
                      "Succeeded"
                    ]
                  },
                  "runtimeConfiguration": {
                    "concurrency": {
                      "repetitions": 10
                    }
                  },
                  "actions": {
                    "Find_existing": {
                      "type": "Query",
                      "runAfter": {},
                      "inputs": {
                        "from": "@body('List_existing')?['value']",
                        "where": "@equals(item()?['crdr_externalid'], items('Upsert')?['externalid'])"
                      }
                    },
                    "Is_new": {
                      "type": "If",
                      "runAfter": {
                        "Find_existing": [
                          "Succeeded"
                        ]
                      },
                      "expression": {
                        "equals": [
                          "@empty(body('Find_existing'))",
                          true
                        ]
                      },
                      "actions": {
                        "Create_signal": {
                          "type": "OpenApiConnection",
                          "runAfter": {},
                          "inputs": {
                            "host": {
                              "connectionName": "shared_commondataserviceforapps",
                              "operationId": "CreateRecord",
                              "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps"
                            },
                            "parameters": {
                              "entityName": "crdr_signals",
                              "item/crdr_actionrequired": "@items('Upsert')?['actionrequired']",
                              "item/crdr_datelabel": "@items('Upsert')?['datelabel']",
                              "item/crdr_externalid": "@items('Upsert')?['externalid']",
                              "item/crdr_feed@odata.bind": "@concat('/crdr_feeds(', items('Each_feed')?['crdr_feedid'], ')')",
                              "item/crdr_firstseen": "@utcNow()",
                              "item/crdr_horizon": "@items('Upsert')?['horizon']",
                              "item/crdr_keydate": "@items('Upsert')?['keydate']",
                              "item/crdr_lastchanged": "@items('Upsert')?['lastchanged']",
                              "item/crdr_products": "@items('Upsert')?['products']",
                              "item/crdr_source": 169890006,
                              "item/crdr_summary": "@items('Upsert')?['summary']",
                              "item/crdr_title": "@items('Upsert')?['title']",
                              "item/crdr_url": "@items('Upsert')?['url']"
                            },
                            "authentication": "@parameters('$authentication')"
                          }
                        },
                        "Create_version": {
                          "type": "OpenApiConnection",
                          "runAfter": {
                            "Create_signal": [
                              "Succeeded"
                            ]
                          },
                          "inputs": {
                            "host": {
                              "connectionName": "shared_commondataserviceforapps",
                              "operationId": "CreateRecord",
                              "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps"
                            },
                            "parameters": {
                              "entityName": "crdr_signalversions",
                              "item/crdr_capturedon": "@utcNow()",
                              "item/crdr_changedfields": "created",
                              "item/crdr_name": "@concat(items('Upsert')?['externalid'], ' ', items('Upsert')?['lastchanged'])",
                              "item/crdr_signal@odata.bind": "@concat('/crdr_signals(', body('Create_signal')?['crdr_signalid'], ')')",
                              "item/crdr_snapshotjson": "@items('Upsert')?['snapshot']"
                            },
                            "authentication": "@parameters('$authentication')"
                          }
                        }
                      },
                      "else": {
                        "actions": {
                          "Update_signal": {
                            "type": "OpenApiConnection",
                            "runAfter": {},
                            "inputs": {
                              "host": {
                                "connectionName": "shared_commondataserviceforapps",
                                "operationId": "UpdateRecord",
                                "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps"
                              },
                              "parameters": {
                                "entityName": "crdr_signals",
                                "item/crdr_actionrequired": "@items('Upsert')?['actionrequired']",
                                "item/crdr_datelabel": "@items('Upsert')?['datelabel']",
                                "item/crdr_horizon": "@items('Upsert')?['horizon']",
                                "item/crdr_keydate": "@items('Upsert')?['keydate']",
                                "item/crdr_lastchanged": "@items('Upsert')?['lastchanged']",
                                "item/crdr_products": "@items('Upsert')?['products']",
                                "item/crdr_summary": "@items('Upsert')?['summary']",
                                "item/crdr_title": "@items('Upsert')?['title']",
                                "item/crdr_url": "@items('Upsert')?['url']",
                                "recordId": "@first(body('Find_existing'))?['crdr_signalid']"
                              },
                              "authentication": "@parameters('$authentication')"
                            }
                          },
                          "Update_version": {
                            "type": "OpenApiConnection",
                            "runAfter": {
                              "Update_signal": [
                                "Succeeded"
                              ]
                            },
                            "inputs": {
                              "host": {
                                "connectionName": "shared_commondataserviceforapps",
                                "operationId": "CreateRecord",
                                "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps"
                              },
                              "parameters": {
                                "entityName": "crdr_signalversions",
                                "item/crdr_capturedon": "@utcNow()",
                                "item/crdr_changedfields": "@concat(if(equals(first(body('Find_existing'))?['crdr_title'], items('Upsert')?['title']), '', 'title; '), if(equals(first(body('Find_existing'))?['crdr_horizon'], items('Upsert')?['horizon']), '', 'horizon; '), if(equals(coalesce(first(body('Find_existing'))?['crdr_datelabel'], ''), items('Upsert')?['datelabel']), '', 'date label; '), if(equals(first(body('Find_existing'))?['crdr_actionrequired'], items('Upsert')?['actionrequired']), '', 'action required; '), if(equals(if(empty(first(body('Find_existing'))?['crdr_keydate']), '', formatDateTime(first(body('Find_existing'))?['crdr_keydate'], 'yyyy-MM-ddTHH:mm:ss')), if(empty(items('Upsert')?['keydate']), '', formatDateTime(items('Upsert')?['keydate'], 'yyyy-MM-ddTHH:mm:ss'))), '', 'key date; '), 'last modified')",
                                "item/crdr_name": "@concat(items('Upsert')?['externalid'], ' ', items('Upsert')?['lastchanged'])",
                                "item/crdr_signal@odata.bind": "@concat('/crdr_signals(', first(body('Find_existing'))?['crdr_signalid'], ')')",
                                "item/crdr_snapshotjson": "@items('Upsert')?['snapshot']"
                              },
                              "authentication": "@parameters('$authentication')"
                            }
                          }
                        }
                      }
                    }
                  }
                }
              }
            },
            "Record_run": {
              "type": "OpenApiConnection",
              "runAfter": {
                "Collect": [
                  "Succeeded",
                  "Failed",
                  "Skipped",
                  "TimedOut"
                ]
              },
              "inputs": {
                "host": {
                  "connectionName": "shared_commondataserviceforapps",
                  "operationId": "CreateRecord",
                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps"
                },
                "parameters": {
                  "entityName": "crdr_collectionruns",
                  "item/crdr_accesstier": 169890000,
                  "item/crdr_collector": "@concat('feed:', items('Each_feed')?['crdr_key'])",
                  "item/crdr_gaps": "@if(greater(length(coalesce(concat(join(variables('gaps'), '; '), if(equals(actions('Collect')?['status'], 'Succeeded'), '', concat(if(empty(variables('gaps')), '', '; '), 'collect ', coalesce(actions('Collect')?['status'], 'not run'), ' (HTTP ', string(coalesce(actions('Get_page')?['outputs']?['statusCode'], '-')), ')'))), '')), 4000), substring(concat(join(variables('gaps'), '; '), if(equals(actions('Collect')?['status'], 'Succeeded'), '', concat(if(empty(variables('gaps')), '', '; '), 'collect ', coalesce(actions('Collect')?['status'], 'not run'), ' (HTTP ', string(coalesce(actions('Get_page')?['outputs']?['statusCode'], '-')), ')'))), 0, 4000), coalesce(concat(join(variables('gaps'), '; '), if(equals(actions('Collect')?['status'], 'Succeeded'), '', concat(if(empty(variables('gaps')), '', '; '), 'collect ', coalesce(actions('Collect')?['status'], 'not run'), ' (HTTP ', string(coalesce(actions('Get_page')?['outputs']?['statusCode'], '-')), ')'))), ''))",
                  "item/crdr_itemcount": "@length(coalesce(actions('Changed')?['outputs']?['body'], json('[]')))",
                  "item/crdr_name": "@concat('feed ', items('Each_feed')?['crdr_key'], ' ', formatDateTime(utcNow(), 'yyyy-MM-dd HH:mm'), if(equals(coalesce(actions('Changed_page')?['outputs'], true), false), ': unchanged', concat(': in scope ', string(length(coalesce(actions('Shape')?['outputs']?['body'], json('[]')))), ', new or changed ', string(length(coalesce(actions('Changed')?['outputs']?['body'], json('[]')))))))",
                  "item/crdr_startedon": "@trigger()?['startTime']"
                },
                "authentication": "@parameters('$authentication')"
              }
            },
            "Update_feed": {
              "type": "OpenApiConnection",
              "runAfter": {
                "Record_run": [
                  "Succeeded",
                  "Failed",
                  "Skipped",
                  "TimedOut"
                ]
              },
              "inputs": {
                "host": {
                  "connectionName": "shared_commondataserviceforapps",
                  "operationId": "UpdateRecord",
                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps"
                },
                "parameters": {
                  "entityName": "crdr_feeds",
                  "item/crdr_lastcheckedon": "@utcNow()",
                  "item/crdr_lastmarker": "@if(equals(actions('Collect')?['status'], 'Succeeded'), if(outputs('Changed_page'), outputs('Marker'), coalesce(items('Each_feed')?['crdr_lastmarker'], '')), coalesce(items('Each_feed')?['crdr_lastmarker'], ''))",
                  "recordId": "@items('Each_feed')?['crdr_feedid']"
                },
                "authentication": "@parameters('$authentication')"
              }
            },
            "If_failed": {
              "type": "If",
              "runAfter": {
                "Update_feed": [
                  "Succeeded",
                  "Failed",
                  "Skipped",
                  "TimedOut"
                ]
              },
              "expression": {
                "equals": [
                  "@equals(actions('Collect')?['status'], 'Succeeded')",
                  false
                ]
              },
              "actions": {
                "Note_failed": {
                  "type": "AppendToArrayVariable",
                  "runAfter": {},
                  "inputs": {
                    "name": "failed",
                    "value": "@items('Each_feed')?['crdr_key']"
                  }
                }
              },
              "else": {
                "actions": {}
              }
            }
          }
        },
        "Fail_if_any_feed_failed": {
          "type": "If",
          "runAfter": {
            "Each_feed": [
              "Succeeded",
              "Failed",
              "Skipped",
              "TimedOut"
            ]
          },
          "expression": {
            "equals": [
              "@empty(variables('failed'))",
              false
            ]
          },
          "actions": {
            "Terminate": {
              "inputs": {
                "runError": {
                  "code": "FeedFailed",
                  "message": "@concat('Feeds that failed: ', join(variables('failed'), ', '))"
                },
                "runStatus": "Failed"
              },
              "runAfter": {},
              "type": "Terminate"
            }
          },
          "else": {
            "actions": {}
          }
        }
      },
      "description": "Change Radar: collect the active RSS feeds (crdr_feed kind rss), such as the Copilot Studio blog: one informational signal per item, dated by publication (ADR 0014)."
    },
    "templateName": ""
